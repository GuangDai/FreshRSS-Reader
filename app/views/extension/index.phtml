<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	$this->partial('aside_configure');
?>
<main class="post">
	<h1><?= _t('admin.extensions.title') ?></h1>
	<?php foreach (Minz_ExtensionManager::getLoadErrors() as $name => $error) { ?>
	<p class="alert alert-error" role="alert"><strong><?= htmlspecialchars($name, ENT_QUOTES, 'UTF-8') ?></strong>:
		<?= FreshRSS_Auth::hasAccess('admin') ? htmlspecialchars($error, ENT_QUOTES, 'UTF-8') : _t('admin.extensions.disabled') ?></p>
	<?php } ?>
	<div class="form-group">
		<label for="extension-search"><?= _t('admin.extensions.name') ?></label>
		<input id="extension-search" type="search" autocomplete="off" aria-controls="extension-installed extension-catalog" />
	</div>
	<form method="post" id="extension-installed">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
	<?php if (!empty($this->extension_list['system'])) { ?>
	<h2><?= _t('admin.extensions.system') ?></h2>
	<ul class="manage-list">
	<?php
		foreach ($this->extension_list['system'] as $ext) {
			$this->ext_details = $ext; ?>
			<li>
			<?php $this->renderHelper('extension/details'); ?>
			</li>
		<?php } ?>
	</ul>
	<?php } ?>

	<?php if (!empty($this->extension_list['user'])) { ?>
	<h2><?= _t('admin.extensions.user') ?></h2>
	<ul class="manage-list">
	<?php
		foreach ($this->extension_list['user'] as $ext) {
			$this->ext_details = $ext; ?>
			<li>
			<?php $this->renderHelper('extension/details'); ?>
			</li>
		<?php } ?>
		</ul>
	<?php }

	if (empty($this->extension_list['system']) && empty($this->extension_list['user'])) {
	?>
	<p class="alert alert-warn"><?= _t('admin.extensions.empty_list') ?></p>
	<?php } ?>
	</form>

	<div id="extension-catalog"<?php if (FreshRSS_Context::userConf()->retrieve_extension_list) { ?>
		data-catalog-url="<?= _url('extension', 'catalog') ?>"<?php } ?>>
		<?php include __DIR__ . '/catalog.phtml'; ?>
	</div>
</main>

<?php $class = isset($this->extension) ? ' active' : ''; ?>
<?php $closelink = isset($this->extension) ? _url('extension', 'index') : ''; ?>
<aside id="slider">
<a class="toggle_aside" href="<?= $closelink ?>#close"><?= _i('close') ?></a>
	<div id="slider-content">
		<?php
			if (isset($this->extension)) {
				$this->renderHelper('extension/configure');
			}
		?>
	</div>
</aside>
<a href="#close" id="close-slider">
	<?= _i('close') ?>
</a>
<script src="../scripts/config.js?<?= @filemtime(PUBLIC_PATH . '/scripts/config.js') ?>"></script>

