	<script nonce="<?= htmlspecialchars($this->readerScriptNonce, ENT_QUOTES, 'UTF-8') ?>">
		// Resolve the saved system theme before any reading content can paint.
		{
			const appearance = JSON.parse(document.getElementById('reader-bootstrap').textContent).preferences;
			if (appearance.theme === 'auto') {
				document.body.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? appearance.darkTheme : appearance.lightTheme;
			}
		}
