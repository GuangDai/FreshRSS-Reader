<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	$language = FreshRSS_Context::userConf()->language;
	$isChinese = str_starts_with(strtolower($language), 'zh');
	$readerText = static fn(string $chinese, string $english): string => htmlspecialchars($isChinese ? $chinese : $english, ENT_QUOTES, 'UTF-8');
	$appearance = $this->readerAppearance;
	$initialTheme = $appearance['theme'] === 'auto' ? $appearance['lightTheme'] : $appearance['theme'];
	$initialStyles = [];
	foreach (['sidebarWidth' => '--sidebar-width', 'listWidth' => '--list-width', 'readingWidth' => '--reading-width',
		'fontSize' => '--reader-font-size'] as $key => $property) {
		$initialStyles[] = $property . ':' . (int)$appearance[$key] . 'px';
	}
	$initialStyles[] = '--reader-line-height:' . ((int)$appearance['lineHeight'] / 100);
?>
