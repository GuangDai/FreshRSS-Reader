<?php
	declare(strict_types=1);

	use FreshRSS\Services\Extensions\ConfigurationService;

	/** @var FreshRSS_View $this */
	if ($this->extension === null) {
		throw new FreshRSS_Context_Exception('Extension not initialised!');
	}
	$description = ConfigurationService::describe($this->extension);
	$values = array_replace($description['values'], $this->extensionSettingsSubmitted);
	$errors = $this->extensionSettingsErrors + $description['errors'];
	$extensionName = urlencode($this->extension->getName());
	foreach ($errors as $field => $error) { ?>
	<p class="alert alert-error" role="alert"><?= htmlspecialchars($field . ': ' . $error, ENT_QUOTES, 'UTF-8') ?></p>
<?php } ?>
<form action="<?= _url('extension', 'settings', 'e', $extensionName) ?>" method="post" data-auto-leave-validation="1">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
	<input type="hidden" name="settings_version" value="<?= htmlspecialchars($description['version'], ENT_QUOTES, 'UTF-8') ?>" />
	<input type="hidden" name="operation" value="save" />
	<?php foreach ($description['schema'] as $key => $spec) {
		$fieldId = 'extension-setting-' . $this->extension->getEntrypoint() . '-' . $key;
		$value = $values[$key] ?? null;
		$secret = $spec['secret'] ?? false;
		$encoded = $value === null ? '' : (is_string($value) ? $value : (json_encode($value, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT) ?: ''));
	?>
	<div class="form-group">
		<label class="group-name" for="<?= htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($spec['label'] ?? $key, ENT_QUOTES, 'UTF-8') ?></label>
		<div class="group-controls">
		<?php if ($secret) { ?>
			<input type="password" id="<?= htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') ?>" name="settings[<?= htmlspecialchars($key, ENT_QUOTES, 'UTF-8') ?>]" value="" autocomplete="new-password" />
			<p><?= _t('admin.extensions.settings.secret_keep') ?></p>
		<?php } elseif (isset($spec['enum'])) { ?>
			<select id="<?= htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') ?>" name="settings[<?= htmlspecialchars($key, ENT_QUOTES, 'UTF-8') ?>]">
			<?php if ($value === null) { ?><option value=""><?= _t('gen.short.not_applicable') ?></option><?php } ?>
			<?php foreach ($spec['enum'] as $option) {
				$optionJson = json_encode($option, JSON_UNESCAPED_UNICODE) ?: '';
			?>
				<option value="<?= htmlspecialchars($optionJson, ENT_QUOTES, 'UTF-8') ?>"<?= $option === $value ? ' selected="selected"' : '' ?>><?= htmlspecialchars(is_string($option) ? $option : $optionJson, ENT_QUOTES, 'UTF-8') ?></option>
			<?php } ?>
			</select>
		<?php } elseif ($spec['type'] === 'boolean') { ?>
			<select id="<?= htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') ?>" name="settings[<?= htmlspecialchars($key, ENT_QUOTES, 'UTF-8') ?>]">
				<?php if ($value === null) { ?><option value="" selected="selected"><?= _t('gen.short.not_applicable') ?></option><?php } ?>
				<option value="true"<?= $value === true ? ' selected="selected"' : '' ?>><?= _t('gen.short.yes') ?></option>
				<option value="false"<?= $value === false ? ' selected="selected"' : '' ?>><?= _t('gen.short.no') ?></option>
			</select>
		<?php } elseif (in_array($spec['type'], ['integer', 'number'], true)) { ?>
			<input type="number" id="<?= htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') ?>" name="settings[<?= htmlspecialchars($key, ENT_QUOTES, 'UTF-8') ?>]" value="<?= htmlspecialchars($encoded, ENT_QUOTES, 'UTF-8') ?>" step="<?= $spec['type'] === 'integer' ? '1' : 'any' ?>"<?= isset($spec['min']) ? ' min="' . $spec['min'] . '"' : '' ?><?= isset($spec['max']) ? ' max="' . $spec['max'] . '"' : '' ?> />
		<?php } else { ?>
			<textarea id="<?= htmlspecialchars($fieldId, ENT_QUOTES, 'UTF-8') ?>" name="settings[<?= htmlspecialchars($key, ENT_QUOTES, 'UTF-8') ?>]" rows="<?= $spec['type'] === 'string' ? '3' : '8' ?>" spellcheck="false"><?= htmlspecialchars($encoded, ENT_QUOTES, 'UTF-8') ?></textarea>
		<?php } ?>
		<?php if (isset($spec['description'])) { ?>
			<p><?= htmlspecialchars($spec['description'], ENT_QUOTES, 'UTF-8') ?></p>
		<?php } ?>
		</div>
	</div>
	<?php } ?>
	<div class="form-group form-actions"><div class="group-controls">
		<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
		<a class="btn" href="<?= _url('extension', 'settings', 'e', $extensionName, 'operation', 'export') ?>"><?= _t('gen.action.export') ?></a>
	</div></div>
</form>
<form action="<?= _url('extension', 'settings', 'e', $extensionName) ?>" method="post">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
	<input type="hidden" name="settings_version" value="<?= htmlspecialchars($description['version'], ENT_QUOTES, 'UTF-8') ?>" />
	<input type="hidden" name="operation" value="import" />
	<label for="extension-settings-import"><?= _t('admin.extensions.settings.import_json') ?></label>
	<textarea id="extension-settings-import" name="settings_import" rows="8" spellcheck="false"></textarea>
	<button type="submit" class="btn"><?= _t('gen.action.import') ?></button>
</form>
