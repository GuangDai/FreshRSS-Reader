<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	if (!Minz_Request::paramBoolean('ajax')) {
		$this->partial('aside_configure');
	}
	$extension = $this->extension;
	if ($extension === null) {
		throw new FreshRSS_Context_Exception('Extension not initialised!');
	}
?>
<div class="post extension-configure">
	<h2>
		<?= $extension->getName() ?> —
		<?= $extension->isEnabled() ? _t('admin.extensions.enabled') : _t('admin.extensions.disabled') ?>
	</h2>

	<?php
		$configure_view = $extension->getConfigureView();
		if ($configure_view !== false) {
			echo $configure_view;
		} elseif ($extension->getType() === 'user' && $extension->getConfigurationSchema() !== []) {
			$this->renderHelper('extension/settings');
		} else {
	?>
	<p class="alert alert-warn"><?= _t('admin.extensions.no_configure_view') ?></p>
	<?php } ?>
	<details>
		<summary><?= _t('gen.menu.about') ?></summary>
		<p class="alert alert-warn"><?= $extension->getDescription() ?> — <?= _t('gen.short.by_author'), ' ', $extension->getAuthor() ?></p>

		<?php if (FreshRSS_Auth::hasAccess('admin')) { ?>
		<form method="post">
			<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
			<div class="form-group form-actions">
				<div class="group-controls">
					<button class="btn btn-attention confirm" formaction="<?= _url('extension', 'remove', 'e', urlencode($extension->getName())) ?>"><?= _t('gen.action.remove') ?></button>
				</div>
			</div>
		</form>
		<?php } ?>
		<p><?= _t('admin.extensions.version') ?>: <?= $extension->getVersion() ?></p>
	</details>
</div>
