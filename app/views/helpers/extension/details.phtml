<?php
	declare(strict_types=1);
	/** @var FreshRSS_View $this */
	if ($this->ext_details === null) {
		throw new FreshRSS_Context_Exception('Extension not initialised!');
	}

	$name_encoded = urlencode($this->ext_details->getName());
	$ext_enabled = $this->ext_details->isEnabled();
	if ($ext_enabled) {
		$button_class = ' active';
		$name_class = '';
		$action = 'disable';
		$title = _t('gen.action.disable');
	} else {
		$button_class = '';
		$name_class = ' disabled';
		$action = 'enable';
		$title = _t('gen.action.enable');
	}
	if ($this->ext_details->getType() === 'user' || FreshRSS_Auth::hasAccess('admin')) {?>
	<button class="switch<?= $button_class ?>" formaction="<?= _url('extension', $action, 'e', $name_encoded) ?>" title="<?= $title ?>" aria-label="<?= htmlspecialchars($title . ' · ' . $this->ext_details->getName(), ENT_QUOTES, 'UTF-8') ?>" aria-pressed="<?= $ext_enabled ? 'true' : 'false' ?>"></button>
	<a class="open-slider configure" title="<?= _t('gen.action.manage') ?>" href="<?= _url('extension', 'configure', 'e', $name_encoded) ?>"><?= _i('configure') ?></a>
	<span class="ext_name<?= $name_class ?>"><?= htmlspecialchars($this->ext_details->getName(), ENT_QUOTES, 'UTF-8') ?></span>
<?php } else { ?>
	<button class="switch<?= $button_class ?>" title="<?= _t('admin.extensions.system.no_rights') ?>" disabled="disabled"></button>
	<span class="ext_name<?= $name_class ?>"><?= htmlspecialchars($this->ext_details->getName(), ENT_QUOTES, 'UTF-8') ?></span>
<?php } ?>
<?php
	$error = Minz_ExtensionManager::getLoadErrors()[$this->ext_details->getName()] ??
		Minz_ExtensionManager::getActivationError($this->ext_details->getName());
	if ($error !== '' && ($this->ext_details->getType() === 'user' || FreshRSS_Auth::hasAccess('admin'))) { ?>
	<span class="alert alert-warn"><?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?></span>
<?php } ?>
