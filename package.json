{
	"name": "freshrss",
	"type": "module",
	"description": "A free, self-hostable aggregator",
	"homepage": "https://freshrss.org/",
	"readmeFilename": "README.md",
	"bugs": {
		"url": "https://github.com/FreshRSS/FreshRSS/issues"
	},
	"keywords": [
		"news",
		"aggregator",
		"RSS",
		"Atom",
		"WebSub"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/FreshRSS/FreshRSS.git"
	},
	"license": "AGPL-3.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"eslint": "eslint .",
		"eslint_fix": "eslint --fix .",
		"markdownlint": "markdownlint-cli2",
		"markdownlint_fix": "markdownlint-cli2 --fix",
		"rtlcss": "rtlcss -d p/themes/ && find p/themes/ -type f -name '*.rtl.rtl.css' -delete",
		"svgo": "find p/ docs/ -name '*.svg' -exec svgo {} + | awk '/:$/{name=$0;next} /KiB/ && !/ - 0% /{print name; print}'",
		"stylelint": "stylelint '**/*.css'",
		"stylelint_fix": "stylelint --fix '**/*.css'",
		"test:frontend": "node --test 'tests/frontend/**/*.test.mjs'",
		"test:browser": "playwright test --config tests/browser/config/default.config.mjs",
		"test:browser:appearance": "playwright test --config tests/browser/config/appearance.config.mjs",
		"test:browser:reading": "playwright test --config tests/browser/config/reading-interactions.config.mjs",
		"test:browser:classic": "playwright test --config tests/browser/config/classic-reading.config.mjs",
		"test:browser:settings": "playwright test --config tests/browser/config/settings-page.config.mjs",
		"test:browser:account": "playwright test --config tests/browser/config/account-settings.config.mjs",
		"test:browser:embed": "playwright test --config tests/browser/config/settings-embed.config.mjs",
		"test:integration:refresh": "python3 tests/integration/refresh/scheduler_test.py && python3 tests/integration/refresh/concurrency_test.py && python3 tests/integration/refresh/control_test.py && python3 tests/integration/refresh/legacy_test.py",
		"test:integration:database": "python3 tests/integration/database/matrix.py",
		"test:integration:api": "node tests/integration/api/auth.mjs",
		"test": "npm run eslint && npm run stylelint && npm run markdownlint && npm run test:frontend",
		"fix": "npm run eslint_fix && npm run stylelint_fix && npm run rtlcss && npm run markdownlint_fix && npm run svgo"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"@stylistic/stylelint-plugin": "^5.3.1",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"markdownlint-cli2": "^0.23.3",
		"neostandard": "^0.14.0-next.1",
		"rtlcss": "^4.3.0",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-order": "^8.1.1",
		"svgo": "^4.1.0"
	},
	"rtlcssConfig": {
		"options": {
			"processUrls": {
				"atrule": true,
				"decl": false
			},
			"stringMap": [
				{
					"name": "import-rtl",
					"priority": 10,
					"exclusive": true,
					"search": ".css",
					"replace": ".rtl.css",
					"options": {
						"scope": "url",
						"ignoreCase": false
					}
				}
			]
		}
	}
}
