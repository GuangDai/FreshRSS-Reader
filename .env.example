# Copy to .env; no credentials are needed for the default SQLite installation.
FRESHRSS_IMAGE=ghcr.io/guangdai/freshrss-reader:latest
FRESHRSS_BIND=0.0.0.0
FRESHRSS_PORT=8080
TZ=Asia/Shanghai
CRON_MIN=*/5
FRESHRSS_MEMORY_LIMIT=1024m
FRESHRSS_CPUS=1.0

# Set the exact address or CIDR of your reverse proxy. 0 ignores forwarded client IPs.
TRUSTED_PROXY=0

# Only required with Docker/production/compose.postgres.yaml.
# Set a unique password before starting the PostgreSQL service.
FRESHRSS_DB_PASSWORD=
